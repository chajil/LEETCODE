#include <stdbool.h>

bool isPalindrome(int x) {
    // Negative numbers cannot be palindromes (e.g., -121 -> 121-)
    // Numbers ending in 0 (except 0 itself) cannot be palindromes (e.g., 10 -> 01)
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    int reversedHalf = 0;
    while (x > reversedHalf) {
        reversedHalf = reversedHalf * 10 + x % 10;
        x /= 10;
    }

    // Even length: x == reversedHalf (e.g., 1221 becomes x = 12, reversedHalf = 12)
    // Odd length: x == reversedHalf / 10 (e.g., 121 becomes x = 1, reversedHalf = 12)
    return x == reversedHalf || x == reversedHalf / 10;
}
