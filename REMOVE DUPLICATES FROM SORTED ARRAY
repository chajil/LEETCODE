int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) return 0;

    int k = 1; // Index for placing the next unique element

    for (int i = 1; i < numsSize; i++) {
        // When a new unique element is found, write it to position k
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
