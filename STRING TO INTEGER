#include <stdio.h>
#include <limits.h>

int myAtoi(char* s) {
    if (!s) return 0;

    int i = 0;

    // 1. Skip leading whitespaces
    while (s[i] == ' ') {
        i++;
    }

    // 2. Check for optional '+' or '-' sign
    int sign = 1;
    if (s[i] == '+' || s[i] == '-') {
        sign = (s[i] == '-') ? -1 : 1;
        i++;
    }

    // 3. Convert digits and handle 32-bit overflow/underflow
    int result = 0;
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Overflow check for positive numbers
        if (sign == 1) {
            if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > 7)) {
                return INT_MAX;
            }
        } 
        // Underflow check for negative numbers
        else {
            if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit >= 8)) {
                return INT_MIN;
            }
        }

        result = result * 10 + digit;
        i++;
    }

    return result * sign;
}
