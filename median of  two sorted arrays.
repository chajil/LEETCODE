#include <stdio.h>
#include <limits.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Ensure nums1 is the smaller array to minimize binary search range
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }

    int m = nums1Size;
    int n = nums2Size;
    int low = 0, high = m;
    int halfLen = (m + n + 1) / 2;

    while (low <= high) {
        int i = low + (high - low) / 2;
        int j = halfLen - i;

        // Boundary checks using INT_MIN and INT_MAX for out-of-bounds
        long long maxLeft1 = (i == 0) ? INT_MIN : nums1[i - 1];
        long long minRight1 = (i == m) ? INT_MAX : nums1[i];

        long long maxLeft2 = (j == 0) ? INT_MIN : nums2[j - 1];
        long long minRight2 = (j == n) ? INT_MAX : nums2[j];

        // Valid partition condition
        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {
            // If total number of elements is odd
            if ((m + n) % 2 != 0) {
                return (double)MAX(maxLeft1, maxLeft2);
            }
            // If total number of elements is even
            return (MAX(maxLeft1, maxLeft2) + MIN(minRight1, minRight2)) / 2.0;
        } 
        // We took too many elements from nums1, shift left
        else if (maxLeft1 > minRight2) {
            high = i - 1;
        } 
        // We took too few elements from nums1, shift right
        else {
            low = i + 1;
        }
    }

    return 0.0;
}
