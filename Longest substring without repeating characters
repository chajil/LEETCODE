int lengthOfLongestSubstring(char* s) {
    int lastSeen[128];
    for (int i = 0; i < 128; i++) {
        lastSeen[i] = -1;
    }

    int maxLength = 0;
    int start = 0;

    for (int i = 0; s[i] != '\0'; i++) {
        unsigned char ch = s[i];
        
        if (lastSeen[ch] >= start) {
            start = lastSeen[ch] + 1;
        }

        lastSeen[ch] = i;

        int currentLength = i - start + 1;
        if (currentLength > maxLength) {
            maxLength = currentLength;
        }
    }

    return maxLength;
}
