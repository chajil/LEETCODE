#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Helper function to expand outward from a given center index
static int expandAroundCenter(const char* s, int left, int right, int len) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return the length of the palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (!s || s[0] == '\0') {
        char* empty = (char*)malloc(1);
        empty[0] = '\0';
        return empty;
    }

    int len = strlen(s);
    int start = 0;
    int maxLen = 0;

    for (int i = 0; i < len; i++) {
        // Case 1: Odd-length palindromes (single character center, e.g., "aba")
        int len1 = expandAroundCenter(s, i, i, len);
        // Case 2: Even-length palindromes (two character center, e.g., "abba")
        int len2 = expandAroundCenter(s, i, i + 1, len);

        int currentMax = (len1 > len2) ? len1 : len2;

        if (currentMax > maxLen) {
            maxLen = currentMax;
            // Calculate the starting index of the palindrome substring
            start = i - (currentMax - 1) / 2;
        }
    }

    // Allocate memory for the output substring (+1 for null-terminator)
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + start, maxLen);
    result[maxLen] = '\0';

    return result;
}
