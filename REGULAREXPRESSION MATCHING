#include <stdbool.h>
#include <string.h>

bool isMatch(char *s, char *p) {
    int m = strlen(s);
    int n = strlen(p);

    // dp[i][j] stores whether s[i...m-1] matches p[j...n-1]
    bool dp[m + 1][n + 1];
    memset(dp, 0, sizeof(dp));

    // Base case: empty string matches empty pattern
    dp[m][n] = true;

    for (int i = m; i >= 0; i--) {
        for (int j = n - 1; j >= 0; j--) {
            // Check if current characters match
            bool first_match = (i < m) && (p[j] == s[i] || p[j] == '.');

            if (j + 1 < n && p[j + 1] == '*') {
                // '*' matches 0 instances: jump past the '*' (dp[i][j + 2])
                // '*' matches 1+ instances: consume character from s (dp[i + 1][j])
                dp[i][j] = dp[i][j + 2] || (first_match && dp[i + 1][j]);
            } else {
                // Standard character match
                dp[i][j] = first_match && dp[i + 1][j + 1];
            }
        }
    }

    return dp[0][0];
}
