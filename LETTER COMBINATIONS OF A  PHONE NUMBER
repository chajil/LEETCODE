#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Standard telephone key mapping
const char* MAPPING[] = {
    "",     // 0
    "",     // 1
    "abc",  // 2
    "def",  // 3
    "ghi",  // 4
    "jkl",  // 5
    "mno",  // 6
    "pqrs", // 7
    "tuv",  // 8
    "wxyz"  // 9
};

void backtrack(char* digits, int index, char* currentCombination, char** result, int* returnSize) {
    // Base Case: If we reach the end of the input string, store the combination
    if (digits[index] == '\0') {
        result[*returnSize] = strdup(currentCombination);
        (*returnSize)++;
        return;
    }

    // Get the corresponding letters for the current digit
    int digit = digits[index] - '0';
    const char* letters = MAPPING[digit];

    // Recurse through all possible letters for the current digit
    for (int i = 0; letters[i] != '\0'; i++) {
        currentCombination[index] = letters[i];
        currentCombination[index + 1] = '\0'; // Null-terminate current path
        backtrack(digits, index + 1, currentCombination, result, returnSize);
    }
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
char** letterCombinations(char* digits, int* returnSize) {
    *returnSize = 0;
    
    if (digits == NULL || digits[0] == '\0') {
        return NULL;
    }

    int len = strlen(digits);
    
    // Allocate space for up to 4^4 = 256 dynamic strings
    char** result = (char**)malloc(256 * sizeof(char*));
    char* currentCombination = (char*)malloc((len + 1) * sizeof(char));

    backtrack(digits, 0, currentCombination, result, returnSize);

    free(currentCombination);
    return result;
}
